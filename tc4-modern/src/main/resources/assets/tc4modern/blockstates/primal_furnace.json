{
  "multipart": [
    {
      "apply": {
        "model": "tc4modern:block/primal_furnace"
      }
    },
    {
      "when": {
        "tube_up": "true"
      },
      "apply": {
        "model": "tc4modern:block/primal_furnace_tube_up"
      }
    },
    {
      "when": {
        "tube_down": "true"
      },
      "apply": {
        "model": "tc4modern:block/node_reactor_tube_down"
      }
    },
    {
      "when": {
        "tube_north": "true"
      },
      "apply": {
        "model": "tc4modern:block/node_reactor_tube_north"
      }
    },
    {
      "when": {
        "tube_south": "true"
      },
      "apply": {
        "model": "tc4modern:block/node_reactor_tube_south"
      }
    },
    {
      "when": {
        "tube_west": "true"
      },
      "apply": {
        "model": "tc4modern:block/node_reactor_tube_west"
      }
    },
    {
      "when": {
        "tube_east": "true"
      },
      "apply": {
        "model": "tc4modern:block/node_reactor_tube_east"
      }
    }
  ]
}
